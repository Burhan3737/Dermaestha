# Dermestha — environment contract (12-factor)
# Copy to .env for local dev; set the real values in Railway/host for prod.
# Pairs with docs/engineering/CONFIG.md (tunable defaults) and docs/engineering/ARCHITECTURE.md §14.5.

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development                       # development | production
PORT=3000
APP_BASE_URL=http://localhost:3000         # public origin (used in emails + Daily room URLs)

# ─── Database (Postgres via Prisma) ─────────────────────────────────────────
# Pin prisma@6.x and @prisma/client@6.x (Prisma 7 dropped in-schema datasource.url). See CONFIG.md §7.
DATABASE_URL=postgresql://user:pass@localhost:5432/dermestha

# ─── Sessions / auth ────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string   # rotate per environment

# ─── Payment (manual offline bank transfer) ─────────────────────────────────
# Phase 1 is fully offline: patients pay by bank transfer and submit a transaction reference;
# the admin verifies it manually. No payment gateway/env. Bank details live in the DB Settings (A6).

# ─── Email adapter ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=console                      # stub (throws) | console (dev logging adapter) | resend (real adapter; requires RESEND_API_KEY)

# ─── Daily.co (video adapter — free tier: room + token only, no webhook) ────
DAILY_API_KEY=
DAILY_DOMAIN=                              # your-team.daily.co

# ─── Resend (email adapter) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=                               # key alone sends only to the account owner's address from onboarding@resend.dev; patient inboxes need a verified domain + RESEND_FROM set to an address on it

# ─── Error tracking (Sentry, DSN-gated) ─────────────────────────────────────
SENTRY_DSN=                                # optional in dev; when set, Sentry init + PII scrubbing

# ─── File uploads ────────────────────────────────────────────────────────────
# Doctor profile photos land here; in Docker this path is the dermestha_uploads volume.
UPLOADS_DIR=./uploads

# ─── Tunable defaults (mirror docs/engineering/CONFIG.md; runtime A6 settings override booking lead) ──
SLOT_GRANULARITY_MIN=30
VIDEO_TOKEN_PRE_MIN=10
VIDEO_TOKEN_POST_MIN=5                       # video-join token stays valid until slotEnd + this many min
RESET_TOKEN_TTL_MIN=60
SESSION_TTL_DAYS=7

# Rate limits / lockout (§3.6)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15
SIGNUP_MAX_PER_IP_HOUR=5
FORGOT_MAX_PER_ACCOUNT_HOUR=5
PAYMENT_INTENT_MAX_PER_PATIENT_HOUR=10       # rate-limits POST /:id/pay (bank-reference submits)

# Video provider: stub (prod default, throws) | mock (dev sim) | daily (free tier: room + token)
VIDEO_PROVIDER=mock
VIDEO_MOCK_SECRET=                          # dev-only mock meeting-token signing key; never used in prod
