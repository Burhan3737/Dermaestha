# Dermestha — DEDICATED env for testing the REAL Daily.co video on the FREE tier (room + token only).
# Git-ignored (see .gitignore). NOTE: the manual-payment pivot removed Daily webhooks entirely, so
# there is NO DAILY_WEBHOOK_SECRET / registration step anymore — this just exercises createRoom +
# issueToken + joining a real Daily room. Run:  node --env-file=.env.daily server/src/index.js

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development                       # http login over localhost works (cookie not Secure-only)
PORT=3000
APP_BASE_URL=http://localhost:3000

# ─── Database (Postgres via Prisma) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/dermestha

# ─── Sessions / auth ────────────────────────────────────────────────────────
SESSION_SECRET=dev-only-daily-test-secret-change-if-you-like-aaaaaaaaaaaa

# ─── Email adapter ──────────────────────────────────────────────────────────
EMAIL_PROVIDER=console

# ─── Daily.co (REAL adapter under test — free tier: room + token only) ──────
VIDEO_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=                              # not read by the adapter/client; leave blank

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ─── Tunable defaults ────────────────────────────────────────────────────────
SLOT_GRANULARITY_MIN=30
VIDEO_TOKEN_PRE_MIN=10
VIDEO_TOKEN_POST_MIN=5
RESET_TOKEN_TTL_MIN=60
SESSION_TTL_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MIN=15
SIGNUP_MAX_PER_IP_HOUR=5
FORGOT_MAX_PER_ACCOUNT_HOUR=5
PAYMENT_INTENT_MAX_PER_PATIENT_HOUR=10
